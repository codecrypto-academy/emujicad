internalType":"address","name":"from","type":"address"},{"internalType":"address","name":"to","type":"address"},{"internalType":"uint256","name":"tokenId","type":"uint256"},{"internalType":"uint256","name":"dateCreated","type":"uint256"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"enum SupplyChain.TransferStatus","name":"status","type":"uint8"}]},{"inputs":[],"stateMutability":"nonpayable","type":"function","name":"unpause"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function","name":"userTokenCount","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function","name":"users","outputs":[{"internalType":"uint256","name":"id","type":"uint256"},{"internalType":"address","name":"userAddress","type":"address"},{"internalType":"enum SupplyChain.UserRole","name":"role","type":"uint8"},{"internalType":"enum SupplyChain.UserStatus","name":"status","type":"uint8"}]},{"inputs":[],"stateMutability":"payable","type":"receive"}],"devdoc":{"kind":"dev","methods":{"acceptOwnership()":{"details":"Solo llamable por el address pendingOwner previamente configurado."},"acceptTransfer(uint256)":{"details":"Solo puede ser llamada por el destinatario de la transferencia..      Actualiza balances y estado de transferencia.      Emite el evento TransferAccepted.      Requiere que el contrato no esté pausado.","params":{"transferId":"ID de la transferencia a aceptar."}},"cancelTransfer(uint256)":{"details":"Solo puede ser llamada por el emisor de la transferencia..      Actualiza balances y estado de transferencia.      Emite el evento TransferCanceller.      Requiere que el contrato no esté pausado.","params":{"transferId":"ID de la transferencia a cancelar."}},"changeStatusUser(address,uint8)":{"params":{"newStatus":"Estado a asignar.","userAddress":"Dirección del usuario."}},"createToken(string,uint8,uint256,string,uint256,uint256)":{"details":"Lanza error si el padre no existe, si el usuario no tiene balance suficiente, o si las validaciones fallan.Para FinishedProduct: valida que el parentId sea RowMaterial, que el usuario tenga balance suficiente, y descuenta los tokens de materia prima.Incrementa contador de tokens y actualiza balance inicial del creador.","params":{"features":"Características adicionales en string JSON.","name":"Nombre del token, obligatorio no vacío.","parentAmount":"Cantidad de tokens de materia prima a consumir. Solo aplica para FinishedProduct. Debe ser mayor que 0 y menor o igual al balance del usuario.","parentId":"ID del token padre. 0 si es materia prima, distinto de 0 para producto terminado.","tokenType":"Tipo de token (RowMaterial o FinishedProduct).","totalSupply":"Cantidad total disponible para el token. Debe ser mayor que cero."}},"getPendingOwner()":{"returns":{"_0":"Dirección del usuario que debe aceptar la transferencia de ownership."}},"getToken(uint256)":{"details":"Requiere que el token exista.","params":{"tokenId":"ID del token a consultar."},"returns":{"creator":"Dirección que creó el token.","dateCreated":"Timestamp de creación.","features":"Características en JSON.","id":"ID del token.","name":"Nombre del token.","parentId":"Token padre relacionado.","tokenType":"Tipo del token.","totalSupply":"Suministro total del token."}},"getTokenBalance(uint256,address)":{"details":"Requiere dirección válida y token existente.","params":{"tokenId":"ID del token.","userAddress":"Dirección del usuario."},"returns":{"_0":"uint Balance del usuario para ese token."}},"getTotalTokens()":{"returns":{"_0":"uint Cantidad total de tokens (ID máximo asignado menos 1)."}},"getTotalTransfers()":{"returns":{"_0":"uint Cantidad total de transferencias (ID máximo asignado menos 1)."}},"getTotalUsers()":{"returns":{"_0":"uint Cantidad total de usuarios (ID máximo asignado menos 1)."}},"getTransfer(uint256)":{"params":{"transferId":"ID de la transferencia a consultar."},"returns":{"_0":"Transfer Estructura completa con datos de la transferencia."}},"getUserInfo(address)":{"params":{"userAddress":"Dirección del usuario consultado."},"returns":{"_0":"user Información del usuario."}},"getUserInfoById(uint256)":{"details":"Requiere que el ID sea válido (mayor que 0 y menor que el próximo ID).","params":{"userId":"Identificador del usuario."},"returns":{"_0":"User Estructura con datos del usuario."}},"getUserTokens(address)":{"details":"⚠️ ADVERTENCIA DE GAS: Esta función puede ser MUY COSTOSA en gas con muchos tokens.      Itera sobre TODOS los tokens existentes (O(n) donde n = cantidad total de tokens).      Recomendaciones:      - Solo para uso OFF-CHAIN (lectura desde frontend/dApps)      - NO llamar desde otros contratos en transacciones on-chain      - Considerar paginación o indexación off-chain para datasets grandes      - Puede fallar por límite de gas si hay demasiados tokens (>1000)","params":{"userAddress":"Dirección del usuario."},"returns":{"_0":"uint[] Array con IDs de tokens activos para el usuario."}},"getUserTransfers(address)":{"details":"⚠️ ADVERTENCIA DE GAS: Esta función es EXTREMADAMENTE COSTOSA en gas con muchas transferencias.      Realiza DOS iteraciones completas sobre TODAS las transferencias existentes:      - Primera iteración: cuenta transferencias del usuario (O(n))      - Segunda iteración: copia transferencias al array resultado (O(n))      Complejidad total: O(2n) donde n = cantidad total de transferencias      Recomendaciones:      - SOLO para uso OFF-CHAIN (lectura desde frontend/dApps)      - NUNCA llamar desde otros contratos en transacciones on-chain      - Implementar indexación off-chain usando eventos para datasets grandes      - Puede fallar por límite de gas si hay >500 transferencias      - Considerar paginación: getUserTransfers(user, startId, endId)","params":{"userAddress":"Dirección del usuario a consultar."},"returns":{"_0":"uint[] Array dinámico con los IDs de transferencias relacionadas."}},"initiateOwnershipTransfer(address)":{"details":"Solo puede ser llamada por el owner y requiere contrato activo (no pausado).","params":{"newOwner":"Dirección del nuevo propietario candidato."}},"isAdmin(address)":{"params":{"userAddress":"Dirección a consultar."},"returns":{"_0":"True si es owner, false en caso contrario."}},"isPaused()":{"returns":{"_0":"bool True si el contrato está pausado, false en caso contrario."}},"pause()":{"details":"Solo el owner o usuarios con rol Pauser pueden pausar si el contrato no está ya pausado."},"rejectTransfer(uint256)":{"details":"Solo puede ser llamada por el destinatario de la transferencia.      Restaura balance del remitente, actualiza estado y emite evento TransferRejected.      Requiere que el contrato no esté pausado.","params":{"transferId":"ID de la transferencia a rechazar."}},"requestUserRole(uint8)":{"params":{"role":"Role solicitado."}},"setPauseRole(address,uint8)":{"params":{"account":"Dirección a la que se asignará el rol.","role":"El rol a asignar (None o Pauser)."}},"transfer(address,uint256,uint256)":{"details":"Solo usuarios con balance suficiente pueden hacer la transferencia, y solo usuarios aprobados y con rol adecuado.Se crea una transferencia en estado Pending, su aceptación o rechazo se debe manejar con funciones específicas.","params":{"amount":"Cantidad de tokens a transferir.","to":"Dirección destinataria de la transferencia.","tokenId":"ID del token a transferir."}},"unpause()":{"details":"Solo el owner o usuarios con rol Pauser pueden reanudar si el contrato estaba pausado."}},"version":1},"userdoc":{"kind":"user","methods":{"acceptOwnership()":{"notice":"El candidato a owner debe aceptar para completar la transferencia de ownership."},"acceptTransfer(uint256)":{"notice":"Acepta una transferencia pendiente, completando el movimiento de tokens entre usuarios."},"addressToUserId(address)":{"notice":"Almacena todas los id de usuario registrados por su direcciones de las billeteras."},"cancelTransfer(uint256)":{"notice":"Cancela una transferencia pendiente por parte del emisor, completando el movimiento de tokens entre usuarios."},"changeStatusUser(address,uint8)":{"notice":"Solo el owner puede cambiar el estado de un usuario."},"createToken(string,uint8,uint256,string,uint256,uint256)":{"notice":"Crea un nuevo token, sea materia prima o producto terminado."},"getPendingOwner()":{"notice":"Getter público para ver quién es el pendingOwner actual."},"getToken(uint256)":{"notice":"Consulta detalles completos de un token específico."},"getTokenBalance(uint256,address)":{"notice":"Consulta el balance de un usuario para un token específico."},"getTotalTokens()":{"notice":"Devuelve el total de tokens registrados en el contrato."},"getTotalTransfers()":{"notice":"Devuelve el total de transferencias creadas en el contrato."},"getTotalUsers()":{"notice":"Devuelve el total de usuarios registrados en el contrato."},"getTransfer(uint256)":{"notice":"Consulta el detalle completo de una transferencia por su ID."},"getUserInfo(address)":{"notice":"Devuelve información completa de un usuario registrado."},"getUserInfoById(uint256)":{"notice":"Devuelve información de un usuario registrado a partir de su ID."},"getUserTokens(address)":{"notice":"Obtiene la lista de IDs de tokens que el usuario posee con saldo positivo."},"getUserTransfers(address)":{"notice":"Obtiene un arreglo de los IDs de todas las transferencias asociadas a un usuario como remitente o destinatario."},"initiateOwnershipTransfer(address)":{"notice":"Inicializa la transferencia de ownership a otra dirección."},"isAdmin(address)":{"notice":"Devuelve si el usuario dado es admin del contrato."},"isPaused()":{"notice":"Consulta el estado actual de pausabilidad del contrato."},"pause()":{"notice":"Pausa todas las funciones críticas del contrato."},"rejectTransfer(uint256)":{"notice":"Rechaza una transferencia pendiente, retornando la cantidad al remitente."},"requestUserRole(uint8)":{"notice":"Función para que usuarios, excepto el owner, soliciten un rol en la plataforma."},"setPauseRole(address,uint8)":{"notice":"Asigna o revoca el rol Pauser a una dirección, controlando autorización para pausar/reanudar."},"transfer(address,uint256,uint256)":{"notice":"Solicita una transferencia de una cantidad específica de un token a otro usuario."},"unpause()":{"notice":"Reanuda la operación normal del contrato si está pausado."},"users(uint256)":{"notice":"Almacena todas los usuarios registrados por su id."}},"version":1}},"settings":{"remappings":["@openzeppelin/=node_modules/@openzeppelin/","forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":false,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/SupplyChain.sol":"SupplyChain"},"evmVersion":"prague","libraries":{}},"sources":{"node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol":{"keccak256":"0x11a5a79827df29e915a12740caf62fe21ebe27c08c9ae3e09abe9ee3ba3866d3","urls":["bzz-raw://3cf0c69ab827e3251db9ee6a50647d62c90ba580a4d7bbff21f2bea39e7b2f4a","dweb:/ipfs/QmZiKwtKU1SBX4RGfQtY7PZfiapbbu6SZ9vizGQD9UHjRA"],"license":"MIT"},"src/SupplyChain.sol":{"keccak256":"0xde5d5f55e69b2dc16c5403767186f6e4f16bf40146296415ca3154aebc73431e","urls":["bzz-raw://5dbb637ad31ac7841a940bb65cddcf1ae8edbc4f5d586a52967cc78420daa310","dweb:/ipfs/QmRZpNqz3Gy1yrLuz7GrBYXjSmgcgdZ3Z83huVSVK3YUS3"],"license":"MIT"}},"version":1},"id":23}