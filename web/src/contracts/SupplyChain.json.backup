\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"dateCreated\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"enum SupplyChain.TransferStatus\",\"name\":\"status\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"unpause\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"userTokenCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"users\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"userAddress\",\"type\":\"address\"},{\"internalType\":\"enum SupplyChain.UserRole\",\"name\":\"role\",\"type\":\"uint8\"},{\"internalType\":\"enum SupplyChain.UserStatus\",\"name\":\"status\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"details\":\"Incluye control de acceso por usuario, validaciones, errores personalizados, contadores para IDs autom\\u00e1ticos,      eventos para la comunicaci\\u00f3n con el exterior y funciones de consulta (getters) completas.IMPORTANTE: Este contrato no maneja transferencias de fondos (criptomonedas), solo registra datos.      Est\\u00e1 dise\\u00f1ado con fines educativos y del proyecto PFM para mostrar c\\u00f3mo se pueden anidar mappings y estructurar      datos complejos en Solidity, una pr\\u00e1ctica com\\u00fan para simular bases de datos en la blockchain.\",\"errors\":{\"ReentrancyGuardReentrantCall()\":[{\"details\":\"Unauthorized reentrant call.\"}]},\"kind\":\"dev\",\"methods\":{\"acceptOwnership()\":{\"details\":\"Solo llamable por el address pendingOwner previamente configurado.\"},\"acceptTransfer(uint256)\":{\"details\":\"Solo puede ser llamada por el destinatario de la transferencia..      Actualiza balances y estado de transferencia.      Emite el evento TransferAccepted.      Requiere que el contrato no est\\u00e9 pausado.\",\"params\":{\"transferId\":\"ID de la transferencia a aceptar.\"}},\"cancelTransfer(uint256)\":{\"details\":\"Solo puede ser llamada por el emisor de la transferencia..      Actualiza balances y estado de transferencia.      Emite el evento TransferCanceller.      Requiere que el contrato no est\\u00e9 pausado.\",\"params\":{\"transferId\":\"ID de la transferencia a cancelar.\"}},\"changeStatusUser(address,uint8)\":{\"params\":{\"newStatus\":\"Estado a asignar.\",\"userAddress\":\"Direcci\\u00f3n del usuario.\"}},\"createToken(string,uint8,uint256,string,uint256,uint256)\":{\"details\":\"Lanza error si el padre no existe, si el usuario no tiene balance suficiente, o si las validaciones fallan.Para FinishedProduct: valida que el parentId sea RowMaterial, que el usuario tenga balance suficiente, y descuenta los tokens de materia prima.Incrementa contador de tokens y actualiza balance inicial del creador.\",\"params\":{\"features\":\"Caracter\\u00edsticas adicionales en string JSON.\",\"name\":\"Nombre del token, obligatorio no vac\\u00edo.\",\"parentAmount\":\"Cantidad de tokens de materia prima a consumir. Solo aplica para FinishedProduct. Debe ser mayor que 0 y menor o igual al balance del usuario.\",\"parentId\":\"ID del token padre. 0 si es materia prima, distinto de 0 para producto terminado.\",\"tokenType\":\"Tipo de token (RowMaterial o FinishedProduct).\",\"totalSupply\":\"Cantidad total disponible para el token. Debe ser mayor que cero.\"}},\"getPendingOwner()\":{\"returns\":{\"_0\":\"Direcci\\u00f3n del usuario que debe aceptar la transferencia de ownership.\"}},\"getToken(uint256)\":{\"details\":\"Requiere que el token exista.\",\"params\":{\"tokenId\":\"ID del token a consultar.\"},\"returns\":{\"creator\":\"Direcci\\u00f3n que cre\\u00f3 el token.\",\"dateCreated\":\"Timestamp de creaci\\u00f3n.\",\"features\":\"Caracter\\u00edsticas en JSON.\",\"id\":\"ID del token.\",\"name\":\"Nombre del token.\",\"parentId\":\"Token padre relacionado.\",\"tokenType\":\"Tipo del token.\",\"totalSupply\":\"Suministro total del token.\"}},\"getTokenBalance(uint256,address)\":{\"details\":\"Requiere direcci\\u00f3n v\\u00e1lida y token existente.\",\"params\":{\"tokenId\":\"ID del token.\",\"userAddress\":\"Direcci\\u00f3n del usuario.\"},\"returns\":{\"_0\":\"uint Balance del usuario para ese token.\"}},\"getTotalTokens()\":{\"returns\":{\"_0\":\"uint Cantidad total de tokens (ID m\\u00e1ximo asignado menos 1).\"}},\"getTotalTransfers()\":{\"returns\":{\"_0\":\"uint Cantidad total de transferencias (ID m\\u00e1ximo asignado menos 1).\"}},\"getTotalUsers()\":{\"returns\":{\"_0\":\"uint Cantidad total de usuarios (ID m\\u00e1ximo asignado menos 1).\"}},\"getTransfer(uint256)\":{\"params\":{\"transferId\":\"ID de la transferencia a consultar.\"},\"returns\":{\"_0\":\"Transfer Estructura completa con datos de la transferencia.\"}},\"getUserInfo(address)\":{\"params\":{\"userAddress\":\"Direcci\\u00f3n del usuario consultado.\"},\"returns\":{\"_0\":\"user Informaci\\u00f3n del usuario.\"}},\"getUserInfoById(uint256)\":{\"details\":\"Requiere que el ID sea v\\u00e1lido (mayor que 0 y menor que el pr\\u00f3ximo ID).\",\"params\":{\"userId\":\"Identificador del usuario.\"},\"returns\":{\"_0\":\"User Estructura con datos del usuario.\"}},\"getUserTokens(address)\":{\"details\":\"\\u26a0\\ufe0f ADVERTENCIA DE GAS: Esta funci\\u00f3n puede ser MUY COSTOSA en gas con muchos tokens.      Itera sobre TODOS los tokens existentes (O(n) donde n = cantidad total de tokens).      Recomendaciones:      - Solo para uso OFF-CHAIN (lectura desde frontend/dApps)      - NO llamar desde otros contratos en transacciones on-chain      - Considerar paginaci\\u00f3n o indexaci\\u00f3n off-chain para datasets grandes      - Puede fallar por l\\u00edmite de gas si hay demasiados tokens (>1000)\",\"params\":{\"userAddress\":\"Direcci\\u00f3n del usuario.\"},\"returns\":{\"_0\":\"uint[] Array con IDs de tokens activos para el usuario.\"}},\"getUserTransfers(address)\":{\"details\":\"\\u26a0\\ufe0f ADVERTENCIA DE GAS: Esta funci\\u00f3n es EXTREMADAMENTE COSTOSA en gas con muchas transferencias.      Realiza DOS iteraciones completas sobre TODAS las transferencias existentes:      - Primera iteraci\\u00f3n: cuenta transferencias del usuario (O(n))      - Segunda iteraci\\u00f3n: copia transferencias al array resultado (O(n))      Complejidad total: O(2n) donde n = cantidad total de transferencias      Recomendaciones:      - SOLO para uso OFF-CHAIN (lectura desde frontend/dApps)      - NUNCA llamar desde otros contratos en transacciones on-chain      - Implementar indexaci\\u00f3n off-chain usando eventos para datasets grandes      - Puede fallar por l\\u00edmite de gas si hay >500 transferencias      - Considerar paginaci\\u00f3n: getUserTransfers(user, startId, endId)\",\"params\":{\"userAddress\":\"Direcci\\u00f3n del usuario a consultar.\"},\"returns\":{\"_0\":\"uint[] Array din\\u00e1mico con los IDs de transferencias relacionadas.\"}},\"initiateOwnershipTransfer(address)\":{\"details\":\"Solo puede ser llamada por el owner y requiere contrato activo (no pausado).\",\"params\":{\"newOwner\":\"Direcci\\u00f3n del nuevo propietario candidato.\"}},\"isAdmin(address)\":{\"params\":{\"userAddress\":\"Direcci\\u00f3n a consultar.\"},\"returns\":{\"_0\":\"True si es owner, false en caso contrario.\"}},\"isPaused()\":{\"returns\":{\"_0\":\"bool True si el contrato est\\u00e1 pausado, false en caso contrario.\"}},\"pause()\":{\"details\":\"Solo el owner o usuarios con rol Pauser pueden pausar si el contrato no est\\u00e1 ya pausado.\"},\"rejectTransfer(uint256)\":{\"details\":\"Solo puede ser llamada por el destinatario de la transferencia.      Restaura balance del remitente, actualiza estado y emite evento TransferRejected.      Requiere que el contrato no est\\u00e9 pausado.\",\"params\":{\"transferId\":\"ID de la transferencia a rechazar.\"}},\"requestUserRole(uint8)\":{\"params\":{\"role\":\"Role solicitado.\"}},\"setPauseRole(address,uint8)\":{\"params\":{\"account\":\"Direcci\\u00f3n a la que se asignar\\u00e1 el rol.\",\"role\":\"El rol a asignar (None o Pauser).\"}},\"transfer(address,uint256,uint256)\":{\"details\":\"Solo usuarios con balance suficiente pueden hacer la transferencia, y solo usuarios aprobados y con rol adecuado.Se crea una transferencia en estado Pending, su aceptaci\\u00f3n o rechazo se debe manejar con funciones espec\\u00edficas.\",\"params\":{\"amount\":\"Cantidad de tokens a transferir.\",\"to\":\"Direcci\\u00f3n destinataria de la transferencia.\",\"tokenId\":\"ID del token a transferir.\"}},\"unpause()\":{\"details\":\"Solo el owner o usuarios con rol Pauser pueden reanudar si el contrato estaba pausado.\"}},\"stateVariables\":{\"addressToUserId\":{\"details\":\"`mapping(address => uint256)`: Asocia una direcci\\u00f3n de billetera (la clave) del User      con el id asignado al `User` (el valor). Es `private` para controlar el acceso.\"},\"users\":{\"details\":\"`mapping(uint256 => User)`: Asocia una el id del usuario (clave)      con la estructura de datos `User` (el valor). Es `private` para controlar el acceso.\"}},\"title\":\"SupplyChain\",\"version\":1},\"userdoc\":{\"errors\":{\"ContractNotPaused()\":[{\"notice\":\"Acci\\u00f3n emitida cuando el contrado no est\\u00e1 pausado.\"}],\"ContractPaused()\":[{\"notice\":\"Acci\\u00f3n emitida cuando el contrado est\\u00e1 pausado.\"}],\"ExistingUserWithApprovedRole()\":[{\"notice\":\"El usuario ya tiene al menos un rol aprobado.\"}],\"InsufficientBalance(uint256,uint256)\":[{\"notice\":\"La cantidad debe ser mayor a 0.\"}],\"InvalidAddress()\":[{\"notice\":\"Lanza si la direcci\\u00f3n es nula o no est\\u00e1 permitida.\"}],\"InvalidAmount()\":[{\"notice\":\"La cantidad debe ser mayor a 0.\"}],\"InvalidName()\":[{\"notice\":\"Lanza si el nombre proporcionado es inv\\u00e1lido o vac\\u00edo.\"}],\"InvalidRole()\":[{\"notice\":\"Lanza si el usuario intenta registrar un rol inv\\u00e1lido.\"}],\"InvalidTotalSupply()\":[{\"notice\":\"El total de suministro no es v\\u00e1lido (>0).\"}],\"InvalidUserId()\":[{\"notice\":\"La consulta o acci\\u00f3n requiere un Id de Usuario existente.\"}],\"NoApproved()\":[{\"notice\":\"Lanza si el usuario no tiene aprobaci\\u00f3n suficiente.\"}],\"NoOwner()\":[{\"notice\":\"Acci\\u00f3n no realizada por el owner.\"}],\"NoReceiverAllowed()\":[{\"notice\":\"No autorizado para Recibir token.\"}],\"NoTransfersAllowed()\":[{\"notice\":\"No autorizado para Transferir token.\"}],\"ParentTokenDoesNotExist()\":[{\"notice\":\"El token padre solicitado no existe.\"}],\"TokenDoesNotExist()\":[{\"notice\":\"La consulta o acci\\u00f3n requiere un token existente.\"}],\"TransferDoesNotExist()\":[{\"notice\":\"La consulta o acci\\u00f3n requiere que la transferencia existenta.\"}],\"TransferNotPending()\":[{\"notice\":\"Transferencia debe estar en Pendiente.\"}],\"Unauthorized()\":[{\"notice\":\"Acci\\u00f3n no autorizada por el rol actual.\"}],\"UserDoesNotExist()\":[{\"notice\":\"La consulta o acci\\u00f3n requiere un Usuario existente.\"}],\"UserWithExistingRole()\":[{\"notice\":\"El usuario ya tiene el rol solicitado.\"}]},\"events\":{\"AssignInitialContractOwner(address)\":{\"notice\":\"Evento de asignaci\\u00f3n inicial de ownership.\"},\"OwnershipTransferInitiated(address,address)\":{\"notice\":\"Evento al iniciar la transferencia de ownership.\"},\"OwnershipTransferred(address,address)\":{\"notice\":\"Evento cuando la transferencia de ownership es confirmada/completada.\"},\"PauseRoleChanged(address,uint8)\":{\"notice\":\"Evento al asignar roles especiales de pausador o revocar.\"},\"Paused(address)\":{\"notice\":\"Evento para pausar el contrato.\"},\"TokenCreated(uint256,address,string,uint8,uint256,uint256)\":{\"notice\":\"Evento cuando se crea un nuevo token.\"},\"TransferAccepted(uint256)\":{\"notice\":\"Evento ante la aceptaci\\u00f3n de una transferencia.\"},\"TransferCancelled(uint256)\":{\"notice\":\"Evento ante la cancelacion de una transferencia.\"},\"TransferRejected(uint256)\":{\"notice\":\"Evento cuando una transferencia ha sido rechazada.\"},\"TransferRequested(uint256,address,address,uint256,uint256)\":{\"notice\":\"Evento que representa una solicitud de transferencia.\"},\"Unpaused(address)\":{\"notice\":\"Evento para reanudar el contrato.\"},\"UserRoleRequested(address,uint8)\":{\"notice\":\"Evento al solicitar un nuevo rol de usuario.\"},\"UserStatusChanged(address,uint8,uint8)\":{\"notice\":\"Evento por cambio de estado de usuario.\"}},\"kind\":\"user\",\"methods\":{\"acceptOwnership()\":{\"notice\":\"El candidato a owner debe aceptar para completar la transferencia de ownership.\"},\"acceptTransfer(uint256)\":{\"notice\":\"Acepta una transferencia pendiente, completando el movimiento de tokens entre usuarios.\"},\"addressToUserId(address)\":{\"notice\":\"Almacena todas los id de usuario registrados por su direcciones de las billeteras.\"},\"cancelTransfer(uint256)\":{\"notice\":\"Cancela una transferencia pendiente por parte del emisor, completando el movimiento de tokens entre usuarios.\"},\"changeStatusUser(address,uint8)\":{\"notice\":\"Solo el owner puede cambiar el estado de un usuario.\"},\"createToken(string,uint8,uint256,string,uint256,uint256)\":{\"notice\":\"Crea un nuevo token, sea materia prima o producto terminado.\"},\"getPendingOwner()\":{\"notice\":\"Getter p\\u00fablico para ver qui\\u00e9n es el pendingOwner actual.\"},\"getToken(uint256)\":{\"notice\":\"Consulta detalles completos de un token espec\\u00edfico.\"},\"getTokenBalance(uint256,address)\":{\"notice\":\"Consulta el balance de un usuario para un token espec\\u00edfico.\"},\"getTotalTokens()\":{\"notice\":\"Devuelve el total de tokens registrados en el contrato.\"},\"getTotalTransfers()\":{\"notice\":\"Devuelve el total de transferencias creadas en el contrato.\"},\"getTotalUsers()\":{\"notice\":\"Devuelve el total de usuarios registrados en el contrato.\"},\"getTransfer(uint256)\":{\"notice\":\"Consulta el detalle completo de una transferencia por su ID.\"},\"getUserInfo(address)\":{\"notice\":\"Devuelve informaci\\u00f3n completa de un usuario registrado.\"},\"getUserInfoById(uint256)\":{\"notice\":\"Devuelve informaci\\u00f3n de un usuario registrado a partir de su ID.\"},\"getUserTokens(address)\":{\"notice\":\"Obtiene la lista de IDs de tokens que el usuario posee con saldo positivo.\"},\"getUserTransfers(address)\":{\"notice\":\"Obtiene un arreglo de los IDs de todas las transferencias asociadas a un usuario como remitente o destinatario.\"},\"initiateOwnershipTransfer(address)\":{\"notice\":\"Inicializa la transferencia de ownership a otra direcci\\u00f3n.\"},\"isAdmin(address)\":{\"notice\":\"Devuelve si el usuario dado es admin del contrato.\"},\"isPaused()\":{\"notice\":\"Consulta el estado actual de pausabilidad del contrato.\"},\"pause()\":{\"notice\":\"Pausa todas las funciones cr\\u00edticas del contrato.\"},\"rejectTransfer(uint256)\":{\"notice\":\"Rechaza una transferencia pendiente, retornando la cantidad al remitente.\"},\"requestUserRole(uint8)\":{\"notice\":\"Funci\\u00f3n para que usuarios, excepto el owner, soliciten un rol en la plataforma.\"},\"setPauseRole(address,uint8)\":{\"notice\":\"Asigna o revoca el rol Pauser a una direcci\\u00f3n, controlando autorizaci\\u00f3n para pausar/reanudar.\"},\"transfer(address,uint256,uint256)\":{\"notice\":\"Solicita una transferencia de una cantidad espec\\u00edfica de un token a otro usuario.\"},\"unpause()\":{\"notice\":\"Reanuda la operaci\\u00f3n normal del contrato si est\\u00e1 pausado.\"},\"users(uint256)\":{\"notice\":\"Almacena todas los usuarios registrados por su id.\"}},\"notice\":\"Solucion de SupplyChain.Este contrato inteligente simula una plataforma de SupplyChain b\\u00e1sica en la blockchain.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/SupplyChain.sol\":\"SupplyChain\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\":@openzeppelin/=node_modules/@openzeppelin/\",\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol\":{\"keccak256\":\"0x11a5a79827df29e915a12740caf62fe21ebe27c08c9ae3e09abe9ee3ba3866d3\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://3cf0c69ab827e3251db9ee6a50647d62c90ba580a4d7bbff21f2bea39e7b2f4a\",\"dweb:/ipfs/QmZiKwtKU1SBX4RGfQtY7PZfiapbbu6SZ9vizGQD9UHjRA\"]},\"src/SupplyChain.sol\":{\"keccak256\":\"0xde5d5f55e69b2dc16c5403767186f6e4f16bf40146296415ca3154aebc73431e\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://5dbb637ad31ac7841a940bb65cddcf1ae8edbc4f5d586a52967cc78420daa310\",\"dweb:/ipfs/QmRZpNqz3Gy1yrLuz7GrBYXjSmgcgdZ3Z83huVSVK3YUS3\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.30+commit.73712a01"},"language":"Solidity","output":{"abi":[{"inputs":[],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"type":"error","name":"ContractNotPaused"},{"inputs":[],"type":"error","name":"ContractPaused"},{"inputs":[],"type":"error","name":"ExistingUserWithApprovedRole"},{"inputs":[{"internalType":"uint256","name":"senderBalance","type":"uint256"},{"internalType":"uint256","name":"amount","type":"uint256"}],"type":"error","name":"InsufficientBalance"},{"inputs":[],"type":"error","name":"InvalidAddress"},{"inputs":[],"type":"error","name":"InvalidAmount"},{"inputs":[],"type":"error","name":"InvalidName"},{"inputs":[],"type":"error","name":"InvalidRole"},{"inputs":[],"type":"error","name":"InvalidTotalSupply"},{"inputs":[],"type":"error","name":"InvalidUserId"},{"inputs":[],"type":"error","name":"NoApproved"},{"inputs":[],"type":"error","name":"NoOwner"},{"inputs":[],"type":"error",